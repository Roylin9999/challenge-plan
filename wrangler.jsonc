{
  "name": "challenge-plan",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "triggers": { "crons": ["*/30 * * * *"] },
  // 60 秒問卷專區：從健康問卷網站（health-quiz）讀顧客紀錄
  "services": [ { "binding": "QUIZ", "service": "health-quiz" } ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "challenge-db",
      // ↓↓↓ 把這一行換成你的 D1 資料庫 ID（在 D1 的 challenge-db 頁面可以複製）
      "database_id": "a6c8fbd2-c72e-420e-9d07-0a9bbc1bffe8"
    }
  ]
}
